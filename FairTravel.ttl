#################################################################
#    Individuals
#################################################################

###  http://www.fairtravel.com/fairtravel#AliGuide
:AliGuide rdf:type owl:NamedIndividual ,
                   :Guide ;
          :worksAt :BioBistro ;
          :guideName "Ali Ben Salah" ;
          :languageSpoken "French" .


###  http://www.fairtravel.com/fairtravel#AliceTourist
:AliceTourist rdf:type owl:NamedIndividual .


###  http://www.fairtravel.com/fairtravel#AlpinePark
:AlpinePark rdf:type owl:NamedIndividual ,
                     :Location .


###  http://www.fairtravel.com/fairtravel#ArtisanMarket_Medina
:ArtisanMarket_Medina rdf:type owl:NamedIndividual ,
                               :LocalShop ;
                      :offeredBy :EcoHotel_Verde ;
                      :usedByTourist :JohnDoe ;
                      :locallyOwned "true"^^xsd:boolean ;
                      :operatingHours "09:00-20:00" ;
                      :priceRange "€-€€" ;
                      :serviceName "Artisan Market Medina" ;
                      :serviceType "Local Handicraft Shop" ;
                      :sustainabilityScore 88 ;
                      :useLocalProducts "true"^^xsd:boolean .


###  http://www.fairtravel.com/fairtravel#Beach_Volleyball
:Beach_Volleyball rdf:type owl:NamedIndividual ,
                           :SportActivity ;
                  :locatedIn :AlpinePark ;
                  :activityName "Beach Volleyball" ;
                  :activityType "Sport" ;
                  :difficultyLevel "Medium" ;
                  :duration "1.5 hours" .


###  http://www.fairtravel.com/fairtravel#BicycleRental
:BicycleRental rdf:type owl:NamedIndividual ,
                        :Transport ;
               :hasCarbonFootprint :CarbonFootprint_BicycleRental ;
               :averageSpeed "15.0"^^xsd:float ;
               :co2PerKm "0.0"^^xsd:float ;
               :fuelType "Human Powered" ;
               :isEcoFriendly "true"^^xsd:boolean ;
               :transportName "City Bicycle Rental" ;
               :transportType "Bicycle" .


###  http://www.fairtravel.com/fairtravel#BioBistro
:BioBistro rdf:type owl:NamedIndividual ,
                    :Restaurant ;
           :locatedIn :MedinaMarketplace ,
                      :TunisCity ;
           :averagePrice "28.5"^^xsd:float ;
           :cuisineType "Vegetarian" ;
           :restaurantName "Bio Bistro Tunis" .


###  http://www.fairtravel.com/fairtravel#Booking1234
:Booking1234 rdf:type owl:NamedIndividual ,
                      :Booking ;
             :bookedBy :AliceTourist ;
