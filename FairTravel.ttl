#################################################################
#    Classes
#################################################################

###  http://www.fairtravel.com/fairtravel#Accommodation
:Accommodation rdf:type owl:Class .


###  http://www.fairtravel.com/fairtravel#AccommodationReview
:AccommodationReview rdf:type owl:Class ;
                     rdfs:subClassOf :Review .


###  http://www.fairtravel.com/fairtravel#Activity
:Activity rdf:type owl:Class ;
          owl:disjointWith :Event .


###  http://www.fairtravel.com/fairtravel#ActivityReview
:ActivityReview rdf:type owl:Class ;
                rdfs:subClassOf :Review .


###  http://www.fairtravel.com/fairtravel#Award
:Award rdf:type owl:Class .


###  http://www.fairtravel.com/fairtravel#Booking
:Booking rdf:type owl:Class .


###  http://www.fairtravel.com/fairtravel#CarbonFootprint
:CarbonFootprint rdf:type owl:Class .


###  http://www.fairtravel.com/fairtravel#CulturalActivity
:CulturalActivity rdf:type owl:Class ;
                  rdfs:subClassOf :Activity .


###  http://www.fairtravel.com/fairtravel#Event
:Event rdf:type owl:Class .


###  http://www.fairtravel.com/fairtravel#Guide
:Guide rdf:type owl:Class .


###  http://www.fairtravel.com/fairtravel#InformationCenter
:InformationCenter rdf:type owl:Class ;
                   rdfs:subClassOf :Service .


###  http://www.fairtravel.com/fairtravel#LocalShop
:LocalShop rdf:type owl:Class ;
           rdfs:subClassOf :Service .


###  http://www.fairtravel.com/fairtravel#Location
:Location rdf:type owl:Class .


###  http://www.fairtravel.com/fairtravel#OutdoorActivity
:OutdoorActivity rdf:type owl:Class ;
                 rdfs:subClassOf :Activity .


###  http://www.fairtravel.com/fairtravel#Recommendation
:Recommendation rdf:type owl:Class ;
                owl:disjointWith :Review .


###  http://www.fairtravel.com/fairtravel#Restaurant
:Restaurant rdf:type owl:Class .


###  http://www.fairtravel.com/fairtravel#Review
:Review rdf:type owl:Class .


###  http://www.fairtravel.com/fairtravel#Service
:Service rdf:type owl:Class .


###  http://www.fairtravel.com/fairtravel#ServiceReview
:ServiceReview rdf:type owl:Class ;
               rdfs:subClassOf :Review .


###  http://www.fairtravel.com/fairtravel#SportActivity
:SportActivity rdf:type owl:Class ;
               rdfs:subClassOf :Activity .


###  http://www.fairtravel.com/fairtravel#SustainabilityPractice
:SustainabilityPractice rdf:type owl:Class .


###  http://www.fairtravel.com/fairtravel#Tourist
:Tourist rdf:type owl:Class .


###  http://www.fairtravel.com/fairtravel#Transport
:Transport rdf:type owl:Class .


###  http://www.fairtravel.com/fairtravel#TransportReview
:TransportReview rdf:type owl:Class ;
                 rdfs:subClassOf :Review .


