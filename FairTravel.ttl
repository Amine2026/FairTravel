@prefix : <http://www.fairtravel.com/fairtravel#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.fairtravel.com/fairtravel#> .

<http://www.fairtravel.com/fairtravel> rdf:type owl:Ontology .

#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.fairtravel.com/fairtravel#bookedBy
:bookedBy rdf:type owl:ObjectProperty ;
          rdfs:domain :Booking ;
          rdfs:range :Tourist .


###  http://www.fairtravel.com/fairtravel#complementsActivity
:complementsActivity rdf:type owl:ObjectProperty ;
                     rdfs:domain :Service ;
                     rdfs:range :Activity .


###  http://www.fairtravel.com/fairtravel#forAccommodation
:forAccommodation rdf:type owl:ObjectProperty ;
                  rdfs:domain :Booking ;
                  rdfs:range :Accommodation .


###  http://www.fairtravel.com/fairtravel#forActivity
:forActivity rdf:type owl:ObjectProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( :Booking
                                         :Recommendation
                                       )
                         ] ;
             rdfs:range :Activity .


###  http://www.fairtravel.com/fairtravel#guidedBy
:guidedBy rdf:type owl:ObjectProperty .


###  http://www.fairtravel.com/fairtravel#hasAward
:hasAward rdf:type owl:ObjectProperty ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( :Accommodation
                                      :Activity
                                      :Service
                                    )
                      ] ;
          rdfs:range :Award .


###  http://www.fairtravel.com/fairtravel#hasLocation
:hasLocation rdf:type owl:ObjectProperty ;
             rdfs:domain [ rdf:type owl:Class ;
                           owl:unionOf ( :Activity
                                         :Event
                                         :Service
                                       )
                         ] ;
             rdfs:range :Location .


###  http://www.fairtravel.com/fairtravel#hasReview
:hasReview rdf:type owl:ObjectProperty ;
           rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( :Accommodation
                                       :Activity
                                       :Service
                                       :Transport
                                     )
                       ] ;
           rdfs:range :Review .


###  http://www.fairtravel.com/fairtravel#hasSustainabilityPractice
:hasSustainabilityPractice rdf:type owl:ObjectProperty ;
                           rdfs:domain :Accommodation ;
                           rdfs:range :SustainabilityPractice .


###  http://www.fairtravel.com/fairtravel#offeredBy
:offeredBy rdf:type owl:ObjectProperty ;
           rdfs:domain :Service ;
           rdfs:range :Accommodation .


###  http://www.fairtravel.com/fairtravel#reviewedBy
:reviewedBy rdf:type owl:ObjectProperty ;
            rdfs:domain :Review ;
            rdfs:range :Tourist .


###  http://www.fairtravel.com/fairtravel#usedByTourist
:usedByTourist rdf:type owl:ObjectProperty ;
               rdfs:domain :Service ;
               rdfs:range :Tourist .


###  http://www.fairtravel.com/fairtravel#visitsRestaurant
:visitsRestaurant rdf:type owl:ObjectProperty .


###  http://www.fairtravel.com/fairtravel#worksAt
:worksAt rdf:type owl:ObjectProperty .


