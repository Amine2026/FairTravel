:CarbonNeutral_Certification rdf:type owl:NamedIndividual ,
                                      :Award ;
                             :awardCategory "Climate Action" ;
                             :awardDate "2025-06-01"^^xsd:date ;
                             :awardDescription "Certified for achieving net-zero carbon emissions through reduction and offsetting" ;
