        <DataPropertyAssertion>
            <DataProperty IRI="#hasDescription"/>
            <NamedIndividual IRI="#GreenValleyEcoLodge"/>
              <Literal>An eco-friendly lodge in Paris, close to the city center.</Literal>
        </DataPropertyAssertion>
        <DataPropertyAssertion>
            <DataProperty IRI="#hasRating"/>
            <NamedIndividual IRI="#GreenValleyEcoLodge"/>
              <Literal datatypeIRI="xsd:float">4.7</Literal>
        </DataPropertyAssertion>
        <DataPropertyAssertion>
            <DataProperty IRI="#pricePerNight"/>
            <NamedIndividual IRI="#GreenValleyEcoLodge"/>
              <Literal datatypeIRI="xsd:float">120.0</Literal>
        </DataPropertyAssertion>
        <DataPropertyAssertion>
            <DataProperty IRI="#sustainabilityScore"/>
            <NamedIndividual IRI="#GreenValleyEcoLodge"/>
              <Literal datatypeIRI="xsd:float">9.2</Literal>
        </DataPropertyAssertion>
        <DataPropertyAssertion>
            <DataProperty IRI="#amenities"/>
            <NamedIndividual IRI="#GreenValleyEcoLodge"/>
              <Literal>WiFi, breakfast, solar panels</Literal>
        </DataPropertyAssertion>
        <DataPropertyAssertion>
            <DataProperty IRI="#contactInfo"/>
            <NamedIndividual IRI="#GreenValleyEcoLodge"/>
              <Literal>info@greenvalley.com</Literal>
        </DataPropertyAssertion>
